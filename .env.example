APP_ENV=development
APP_VERSION=0.1.0
DATA_MODE=live
DATABASE_URL=sqlite:///./floodguard.db
DEFAULT_LOCATION_ID=JHG_001
DEFAULT_MONITORING_INTERVAL=60
MONITORING_DOWNGRADE_COOLDOWN_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
GIS_CACHE_TTL_SECONDS=1800
GIS_WEATHER_BATCH_SIZE=40
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=10
FLOOD_API_BASE_URL=https://flood-api.open-meteo.com/v1/flood
FLOOD_API_TIMEOUT_SECONDS=10
# Google approval and Flood Forecasting API enablement are required.
# Keep this key on the backend; never use a VITE_ variable for it.
GOOGLE_FLOOD_API_KEY=
GOOGLE_FLOOD_REGION_CODES=PK
GOOGLE_FLOOD_CACHE_SECONDS=600
ML_MODEL_ENABLED=false
SAR_UNET_MODEL_DIR=
ML_MODEL_PATH=app/ml/artifacts/flood_risk_xgboost.json
ALLOW_RULE_BASED_FALLBACK=false
ENABLE_SIMULATION=false
EXPOSURE_DATASET_ROOT=../flood_model/exposure_infrastructure/datasets/exposure
# Leave empty to write analyses below EXPOSURE_DATASET_ROOT/analysis.
EXPOSURE_OUTPUT_ROOT=
